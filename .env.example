# Port the API/server listens on (the Vite dev server proxies /api here).
PORT=4000

# Where the catalog SQLite database lives.
DATABASE_PATH=./data/catalog.sqlite

# Optional. When set, the login form is locked to this Ghost site and users
# only supply their Staff Access Token. Leave unset to let users type the site
# URL at login (it is remembered in the browser after the first sign-in).
# Example: https://example.com
GHOST_URL=

# Comma-separated origins allowed to call the API in development.
CORS_ORIGIN=http://localhost:5173

# Set when a reverse proxy terminates TLS in front of the app, so the session
# cookie is issued with the Secure attribute. Accepts `true`, a hop count, or a
# subnet list (passed straight to Express's `trust proxy`). Default: false.
TRUST_PROXY=
